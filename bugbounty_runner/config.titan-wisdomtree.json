{
  "titan_profile": "V PRO 1.0",
  "programs": [
    {
      "name": "wisdomtree",
      "targets": [
        "https://api.wisdomtreeprimeapp.com",
        "https://app.wisdomtreeconnect.com/api/",
        "https://app.wisdomtreeconnect.com/o/token/",
        "https://app.wisdomtreeconnect.com"
      ],
      "exclude_paths": [],
      "excluded_hosts": [
        "wisdomtree.com",
        "wisdomtree.eu",
        "dataspanapi.wisdomtree.com"
      ],
      "notes": "Only bounty/submission-eligible URL assets from the user-provided WisdomTree HackerOne CSV. Excluded hosts remain authoritative. Mobile apps omitted from this web/API campaign. No data modification, privilege escalation, PII/auth/bank data collection, service degradation, or access beyond minimum necessary proof."
    }
  ],
  "max_requests_per_target_per_runner": 24,
  "delay_ms": 1000,
  "runner_count": 12,
  "evidence_policy": {
    "store_response_bodies": false,
    "store_secret_values": false,
    "store_auth_material": false,
    "store_pii_values": false
  },
  "scope_policy": {
    "discovered_urls_must_be_allowlisted": true,
    "follow_redirects": false,
    "third_party_fetches": false
  },
  "enabled_modules": [
    "surface",
    "headers",
    "well_known",
    "cookie_security",
    "js_routes",
    "api_hints",
    "sourcemaps",
    "auth_boundary",
    "method_diff",
    "cors",
    "cache",
    "redirects",
    "xss_reflection",
    "sqli_differential",
    "error_diff",
    "error_disclosure",
    "openapi_graphql",
    "sensitive_files",
    "dns_http_inventory",
    "fingerprints",
    "status_anomaly",
    "content_type_diff",
    "path_normalization_diff",
    "encoding_diff",
    "header_behavior_diff",
    "method_consistency",
    "response_shape_diff",
    "cache_variance"
  ],
  "aggressive_modules": [],
  "notes": "TITAN V PRO WisdomTree-only 12-runner safe campaign. ScopeGuard, rate budget, semantic differential controls, evidence redaction, exact false-positive memory and per-action reporting enabled. Credential-required testing excluded."
}
