{
  "titan_profile": "V PRO 1.0 - WOLT PHASE 1",
  "authorized_scope_reviewed": true,
  "programs": [
    {
      "name": "wolt",
      "targets": [
        "https://wolt.com",
        "https://restaurant-api.wolt.com",
        "https://authentication.wolt.com"
      ],
      "exclude_paths": [],
      "excluded_hosts": [],
      "notes": "Wolt HackerOne Tier-1 Phase 1. Public/unauthenticated low-impact testing only. Never access accounts or data not owned by the researcher. Do not test payment processors, Customer Support, brute force, DoS/DDoS, or mass-create entities."
    }
  ],
  "request_headers": {
    "X-HackerOne-Research": "ghosther"
  },
  "max_requests_per_target_per_runner": 12,
  "delay_ms": 1500,
  "runner_count": 12,
  "evidence_policy": {
    "store_response_bodies": false,
    "store_secret_values": false,
    "store_auth_material": false,
    "store_pii_values": false
