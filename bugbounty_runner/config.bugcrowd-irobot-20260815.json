{
  "titan_profile": "V PRO 1.0 Bugcrowd iRobot reviewed-scope",
  "template_only": false,
  "programs": [
    {
      "name": "bugcrowd-irobot",
      "targets": [
        "https://www.irobot.com/",
        "https://aspen-ecommerce-prod.iot.irobotapi.com/dev/v1/ecommerce/entitlements/00000000-0000-0000-0000-000000000000",
        "https://aspen-ecommerce-prod.iot.irobotapi.com/dev/v1/ecommerce/robots/00000000-0000-0000-0000-000000000000/entitlements",
        "https://aspen-ecommerce-prod.iot.irobotapi.com/dev/v1/ecommerce/users/00000000-0000-0000-0000-000000000000/entitlements",
        "https://zuora-ecommerce-prod.iot.irobotapi.com/dev/v1/ecommerce/notifications/raas"
      ],
      "exclude_paths": [],
      "excluded_hosts": [
        "homesupport.irobot.com",
        "about.irobot.com",
        "global.irobot.com",
        "hosted-pages.id.me"
      ],
      "notes": "Subset made only from targets explicitly listed in the current public Bugcrowd-derived scope snapshot. UUID zero values are researcher-controlled invalid placeholders; never substitute identifiers belonging to other users or robots without explicit authorization. Third-party hosts remain blocked."
