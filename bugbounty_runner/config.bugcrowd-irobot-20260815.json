  "scope_policy": {
    "discovered_urls_must_be_allowlisted": true,
    "follow_redirects": false,
    "third_party_fetches": false
  },
  "enabled_modules": [
    "surface",
    "headers",
    "well_known",
    "cookie_security",
    "js_routes",
    "api_hints",
    "sourcemaps",
    "auth_boundary",
    "method_diff",
    "cors",
    "cache",
    "openapi_graphql",
    "dns_http_inventory",
    "fingerprints",
    "status_anomaly",
    "content_type_diff",
    "path_normalization_diff",
    "encoding_diff",
    "header_behavior_diff",
    "method_consistency",
    "response_shape_diff",
    "cache_variance"
  ],
  "aggressive_modules": [],
  "notes": "Initial iRobot pass stays non-destructive until full engagement-rule text is available. Authorization tests use only controlled/fake identifiers; no access to third-party records, no brute force, no DoS, no transactional side effects."
}