{
  "programs": [
    {
      "name": "klarna",
      "targets": [
        "https://portal.playground.klarna.com",
        "https://app.klarna.com"
      ],
      "exclude_paths": [],
      "notes": "Only explicitly eligible HackerOne assets."
    },
    {
      "name": "freshworks-example",
      "targets": [
        "https://your-owned-tenant.freshdesk.com"
      ],
      "exclude_paths": [
        "/crm/"
      ],
      "notes": "Use only a tenant owned by the researcher."
    }
  ],
  "max_requests_per_target_per_runner": 30,
  "delay_ms": 900,
  "runner_count": 8,
  "enabled_modules": [
    "surface",
    "js_routes",
    "auth_boundary",
    "cors",
    "redirects",
    "cache",
    "xss_reflection",
    "sqli_differential"
  ],
  "aggressive_modules": [],
  "notes": "Every target must be explicitly authorized and bounty-eligible. Aggressive modules stay disabled unless that program explicitly permits them."
}
